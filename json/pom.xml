<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.xyz-jphil</groupId>
    <artifactId>xyz-jphil-datahelper-json</artifactId>
    <!--
      1.2 — PRP-30: enums survive a JSON round trip, and a List of them reads back as constants.
        * FIX MinimalJsonWriter had no enum case at all, so an enum fell to the toString() fallback
          and was written as the constant NAME — even under @AsUuid, where fromJson resolves through
          a uuid-keyed lookup, so the value came back null. toJson wrote a form its own reader could
          not read. Pre-existing since PRP-28 phase 1 for a bare enum field; found by PRP-30's list.
        * The list side comes free from base 1.3, since fromJson is the parse plus fromMap.
        Requires base 1.3.
      1.1 — PRP-29: fromJson is now the parse plus DataHelper_I.fromMap (base 1.2), replacing this
        trait's own copy of the object walk. That copy was gated on `instanceof Json_I`, so a nested
        @Data block read back null and a List of them read back holding raw maps — the same defect,
        and the same cause, as the ArcadeDB one this PRP was opened for. Behaviour is otherwise
        unchanged, and enum-typed fields now resolve on read, which they previously did not.
    -->
    <version>1.2</version>
    <packaging>jar</packaging>

    <name>DataHelper JSON Trait</name>
    <description>JSON serialization/deserialization trait for DataHelper - JVM only, uses direct property accessors</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- DataHelper Base - property accessors only -->
        <dependency>
            <groupId>io.github.xyz-jphil</groupId>
            <artifactId>xyz-jphil-datahelper-base</artifactId>
            <version>1.3</version>
        </dependency>
    </dependencies>
</project>
