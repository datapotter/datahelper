<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.datapotter</groupId>
        <artifactId>datapotter-datahelper</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <artifactId>datapotter-datahelper-json</artifactId>
    <!--
      1.2 — PRP-30: enums survive a JSON round trip, and a List of them reads back as constants.
        * FIX MinimalJsonWriter had no enum case at all, so an enum fell to the toString() fallback
          and was written as the constant NAME — even under @AsUuid, where fromJson resolves through
          a uuid-keyed lookup, so the value came back null. toJson wrote a form its own reader could
          not read. Pre-existing since PRP-28 phase 1 for a bare enum field; found by PRP-30's list.
        * The list side comes free from base 1.3, since fromJson is the parse plus fromMap.
        Requires base 1.3.
      1.1 — PRP-29: fromJson is now the parse plus DataHelper_I.fromMap (base 1.2), replacing this
        trait's own copy of the object walk. That copy was gated on `instanceof Json_I`, so a nested
        @Data block read back null and a List of them read back holding raw maps — the same defect,
        and the same cause, as the ArcadeDB one this PRP was opened for. Behaviour is otherwise
        unchanged, and enum-typed fields now resolve on read, which they previously did not.
    -->
    <packaging>jar</packaging>

    <name>DataPotter DataHelper JSON</name>
    <description>JSON serialization/deserialization trait for DataHelper - JVM only, uses direct property accessors.</description>
    <url>https://github.com/datapotter/datahelper</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>datapotter</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/datapotter</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/datapotter/datahelper.git</connection>
        <developerConnection>scm:git:ssh://github.com:datapotter/datahelper.git</developerConnection>
        <url>https://github.com/datapotter/datahelper</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- DataHelper Base - property accessors only -->
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-base</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
