<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.datapotter</groupId>
    <artifactId>datapotter-datahelper</artifactId>
    <version>2.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DataPotter DataHelper (parent)</name>
    <description>The backend-agnostic core: annotations, base runtime, JSON trait, annotation processor.</description>
    <url>https://github.com/datapotter/datahelper</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>datapotter</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/datapotter</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/datapotter/datahelper.git</connection>
        <developerConnection>scm:git:ssh://github.com:datapotter/datahelper.git</developerConnection>
        <url>https://github.com/datapotter/datahelper</url>
    </scm>

    <!--
      ONE VERSION FOR THESE FOUR, because they genuinely do move in lockstep — the changelogs say so
      in as many words ("Requires base 1.2", "this REQUIRES base 1.3", "base 1.3 is required, not
      optional"). Generated code from the processor does not compile against an older base, so a
      version matrix here describes combinations that were never going to work.

      Intra-module dependencies read ${project.version}. Before this, each module's own version was a
      SNAPSHOT while its dependencies pinned the last RELEASED sibling — so a snapshot was compiled
      against released code, and a type added in the snapshot was invisible to the module next door.
      That is now impossible to reintroduce.

      THE ARCADEDB MODULES ARE DELIBERATELY NOT HERE. They are a downstream consumer of this, not a
      part of it: the dependency runs one way, and their release history shows them moving
      independently (arcadedbhelper reached 1.8 while annotations reached 1.2, and several of those
      releases explicitly changed nothing here). A second backend would be a third reactor beside
      them, never another entry in this list.
    -->

    <modules>
        <module>annotations</module>
        <module>base</module>
        <module>json</module>
        <module>processor</module>
    </modules>

    <!--
      The parent is itself a published artifact: every module names it as <parent>, so a consumer
      that cannot resolve this pom cannot resolve any module. It therefore needs the same signing
      and publishing wiring the modules have. Without it the deploy phase falls through to
      maven-deploy-plugin, which has no distributionManagement and fails the reactor before a
      single module is uploaded.

      RELEASE WITH MAVEN 3, NOT MAVEN 4:

          C:\user\Apps\cmdtools\maven\apache-maven\bin\mvn.cmd clean deploy -Dorg.name=datapotter

      central-publishing-maven-plugin 0.9.0 is a Maven 3 plugin. Under Maven 4 the extensions=true
      lifecycle binding below does not take effect: gpg:sign and install run, the reactor prints
      BUILD SUCCESS, and NOTHING IS EVER UPLOADED. There is no error to notice. Verify a release by
      fetching the artifact from repo1.maven.org, never by trusting the build result. Propagation to
      repo1 lags the portal by roughly ten to thirty minutes, so a 404 straight after a publish is
      normal; the portal saying "was successfully published" is the authoritative signal.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
