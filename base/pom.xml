<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.datapotter</groupId>
    <artifactId>datapotter-datahelper-base</artifactId>
    <!--
      1.3 — PRP-30: a List of enums is storable, on the same terms as a bare enum field.
        * NEW DataHelper_I.isEnumListField(String), beside isEnumField. Generated code overrides it,
          so a build pairing generated _A classes from processor 1.3 with base 1.2 does not compile.
        * MapReads resolves each element of such a list through the same per-field lookup a bare enum
          field uses. An element matching no constant is DROPPED, not stored as null: List<E> has no
          way to keep the unrecognised string, and a null in that list would travel (List.copyOf in
          the record projection, and every caller that iterates) and fail far from this field.
        Additive for callers; source-compatible.
      1.2 — PRP-29: map-to-object deserialisation moves DOWN to here, so it can reach a @Data
        embedded block. Previously the only deserialiser lived on the ArcadeDB trait and was gated
        on `instanceof ArcadeDoc_I`, which is false for every @Data block — such a block was written
        correctly and read back null, and a List of them read back holding raw LinkedHashMaps inside
        a list declared as the DTO type. Nothing in the walk was ArcadeDB-specific.
        * NEW MapReads (the walk) + MapReadContext (what a backend adds: its own record types, and
          field shapes only it has). The context travels with the recursion, not with the object, so
          an embedded @Data block two levels down is still read in the outer backend's terms.
        * NEW MapWrites, the mirror; DataHelper_I.fromMap(Map) and DataHelper_IR.toMap(), so a @Data
          type round-trips through a plain map with no database on the classpath.
        * MOVED IN from ArcadeDoc_I: isEnumField / resolveEnumFromStorage. Enum resolution is not a
          database concept, and a @Data block's generated code cannot override a method declared on
          a trait it does not implement.
        * A nested value that cannot be given its declared type now throws, naming the type and the
          field, instead of being stored as-is. Putting a foreign object into a typed list turned a
          clear failure into a ClassCastException in unrelated code much later.
        Additive for callers; source-compatible.
    -->
    <version>1.3</version>
    <packaging>jar</packaging>

    <name>DataPotter DataHelper Base</name>
    <description>Shared runtime interfaces and traits (property access, map read/write, enum resolution) used by DataHelper's generated code.</description>
    <url>https://github.com/datapotter/datahelper</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>datapotter</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/datapotter</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/datapotter/datahelper.git</connection>
        <developerConnection>scm:git:ssh://github.com:datapotter/datahelper.git</developerConnection>
        <url>https://github.com/datapotter/datahelper</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
